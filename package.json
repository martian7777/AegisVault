{
  "name": "aegisvault",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "dev": "pnpm --filter @aegisvault/web run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.7.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
