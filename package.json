{
  "name": "aegisvault",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "dev": "pnpm --filter @aegisvault/web run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^3.2.6",
    "dependency-cruiser": "^16.7.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
